{
  "openapi": "3.1.0",
  "info": {
    "title": "Cropbox Web API",
    "version": "0.2.0",
    "description": "HTTP interface to a Cropbox system. Every POST request is stateless: the body is parsed, merged under trusted server-side `request_defaults`, and dispatched to `simulate`, `visualize`, `evaluate` or `calibrate`. Model-specific metadata comes from `GET /api/model`."
  },
  "paths": {
    "/api/model": {
      "get": {
        "summary": "Model description",
        "description": "Systems, parameters with defaults, output variables and provided-table bindings of the served system.",
        "responses": {"200": {"description": "Model description", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelDescription"}}}}}
      }
    },
    "/api/dashboard": {
      "get": {
        "summary": "Dashboard metadata",
        "description": "Editable controls, selectable outputs, plot panels and simulation defaults derived from the model description.",
        "responses": {"200": {"description": "Dashboard metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WidgetPayload"}}}}}
      }
    },
    "/api/schema": {
      "get": {
        "summary": "Schema fragments",
        "description": "The route table and the component schemas of this document.",
        "responses": {"200": {"description": "Schema fragments", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    },
    "/api/openapi": {
      "get": {"summary": "This OpenAPI document", "responses": {"200": {"description": "OpenAPI document", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/docs": {
      "get": {"summary": "Swagger UI", "responses": {"200": {"description": "HTML page rendering this document", "content": {"text/html": {}}}}}
    },
    "/api/simulate": {
      "post": {
        "summary": "Run a simulation",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationRequest"}}}},
        "responses": {
          "200": {"description": "Simulation table", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TablePayload"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/visualize": {
      "post": {
        "summary": "Render a plot as SVG",
        "description": "Either simulates the model (`config`, `stop`, `snap`, `base`, `xstep`) or plots a table passed as `data`.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VisualizationRequest"}}}},
        "responses": {
          "200": {"description": "SVG document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VisualizationResponse"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/evaluate": {
      "post": {
        "summary": "Evaluate a metric against observations",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EvaluationRequest"}}}},
        "responses": {
          "200": {"description": "Metric value(s)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EvaluationResponse"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/calibrate": {
      "post": {
        "summary": "Calibrate parameters against observations",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CalibrationRequest"}}}},
        "responses": {
          "200": {"description": "Calibrated configuration", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CalibrationResponse"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {"description": "Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    },
    "schemas": {
      "Value": {
        "description": "A scalar with an optional unit and declared type. Plain JSON numbers, booleans and strings are accepted wherever a Value is expected.",
        "oneOf": [
          {"type": ["number", "boolean", "string", "null"]},
          {"type": "object", "required": ["value"], "properties": {
            "value": {"type": ["number", "boolean", "string", "null"]},
            "unit": {"type": ["string", "null"], "description": "Unit label such as `m`, `K*d`, `μmol*mol^-1`, `°C`."},
            "type": {"type": ["string", "null"], "enum": ["Bool", "Int", "Float64", "String", "Symbol", "Date", "DateTime", "ZonedDateTime", null]},
            "timezone": {"type": "string", "description": "IANA zone for `ZonedDateTime` values without an offset."}
          }}
        ]
      },
      "Column": {
        "type": "object", "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "type": {"type": ["string", "null"], "enum": ["Bool", "Int", "Float64", "String", "Symbol", "Date", "DateTime", "ZonedDateTime", null]},
          "unit": {"type": ["string", "null"]},
          "timezone": {"type": "string"}
        }
      },
      "Table": {
        "description": "A table given as CSV text or as columns and row arrays. CSV headers may carry `name (unit)` or `name (:Type)` annotations when no `columns` are given.",
        "oneOf": [
          {"type": "object", "required": ["type", "content"], "properties": {
            "type": {"const": "CSV"}, "content": {"type": "string"}, "filename": {"type": "string"},
            "columns": {"type": "array", "items": {"$ref": "#/components/schemas/Column"}}
          }},
          {"type": "object", "required": ["type", "columns", "rows"], "properties": {
            "type": {"const": "DataFrame"},
            "columns": {"type": "array", "items": {"$ref": "#/components/schemas/Column"}},
            "rows": {"type": "array", "items": {"type": "array"}}
          }}
        ]
      },
      "Config": {
        "description": "Parameter values keyed by `System.name` paths, or nested `{System: {name: value}}` objects. Both shapes may be mixed. Table parameters take a Table.",
        "type": "object",
        "additionalProperties": {"oneOf": [{"$ref": "#/components/schemas/Value"}, {"$ref": "#/components/schemas/Table"}, {"type": "object", "additionalProperties": {"oneOf": [{"$ref": "#/components/schemas/Value"}, {"$ref": "#/components/schemas/Table"}]}}]}
      },
      "Names": {
        "description": "Variable paths such as `leaf.area`; an object maps output column names to paths.",
        "oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}, {"type": "object", "additionalProperties": {"type": "string"}}]
      },
      "SimulationRequest": {
        "type": "object",
        "properties": {
          "config": {"$ref": "#/components/schemas/Config"},
          "configs": {"type": "array", "items": {"$ref": "#/components/schemas/Config"}, "description": "Several configurations, each merged over `config`, producing a stacked table."},
          "index": {"$ref": "#/components/schemas/Names"},
          "target": {"$ref": "#/components/schemas/Names"},
          "meta": {"$ref": "#/components/schemas/Names"},
          "base": {"type": "string"},
          "stop": {"$ref": "#/components/schemas/Value", "description": "Update count (number), duration (`{value, unit}`) or the path of a condition variable (string)."},
          "snap": {"$ref": "#/components/schemas/Value", "description": "Snapshot interval (`{value, unit}`) or the path of a condition variable."},
          "seed": {"type": "integer"},
          "nounit": {"type": "boolean"},
          "long": {"type": "boolean"},
          "options": {"type": "object", "description": "Keyword options for the system constructor."}
        },
        "examples": [{"config": {"Plant.size": {"value": 3, "unit": "m"}}, "stop": {"value": 4, "unit": "hr"}, "target": ["size", "growth"]}]
      },
      "VisualizationRequest": {
        "allOf": [{"$ref": "#/components/schemas/SimulationRequest"}],
        "properties": {
          "x": {"type": "string", "default": "time"},
          "y": {"$ref": "#/components/schemas/Names"},
          "kind": {"type": "string", "enum": ["line", "scatter", "scatterline", "step"]},
          "backend": {"type": "string", "enum": ["Makie"]},
          "xstep": {"type": "object", "properties": {"path": {"type": "string"}, "start": {"$ref": "#/components/schemas/Value"}, "stop": {"$ref": "#/components/schemas/Value"}, "step": {"$ref": "#/components/schemas/Value"}, "unit": {"type": "string"}, "values": {"type": "array"}}},
          "plot": {"type": "object", "description": "Plot options: title, xlab, ylab, legend, legendpos, names, colors, xlim, ylim, xunit, yunit, aspect, linestyle."},
          "data": {"$ref": "#/components/schemas/Table", "description": "Plot this table instead of simulating."}
        },
        "required": ["y"]
      },
      "EvaluationRequest": {
        "allOf": [{"$ref": "#/components/schemas/SimulationRequest"}],
        "properties": {
          "observed": {"$ref": "#/components/schemas/Table"},
          "target": {"$ref": "#/components/schemas/Names"},
          "metric": {"type": "string", "default": "rmse"}
        },
        "required": ["observed", "target"]
      },
      "CalibrationRequest": {
        "allOf": [{"$ref": "#/components/schemas/EvaluationRequest"}],
        "properties": {
          "parameters": {"type": "object", "description": "Bounds per parameter path: `[lower, upper]` or `{lower, upper, unit}`, in the same flat or nested shape as `config`."},
          "weight": {"type": "array", "items": {"type": "number"}},
          "pareto": {"type": "boolean"},
          "optim": {"type": "object", "description": "Options for the BlackBoxOptim optimizer (e.g. `MaxSteps`, `Method`)."}
        },
        "required": ["parameters"]
      },
      "TablePayload": {
        "type": "object",
        "properties": {
          "status": {"const": "ok"}, "contract_version": {"type": "string"}, "model": {"type": "string"},
          "columns": {"type": "array", "items": {"$ref": "#/components/schemas/Column"}},
          "rows": {"type": "array", "items": {"type": "array"}, "description": "Plain values; non-finite numbers are null."},
          "summary": {"type": "object", "properties": {"nrow": {"type": "integer"}, "elapsed_ms": {"type": "integer"}}}
        }
      },
      "VisualizationResponse": {
        "type": "object",
        "properties": {"status": {"const": "ok"}, "contract_version": {"type": "string"}, "model": {"type": "string"}, "operation": {"const": "visualize"}, "format": {"const": "svg"}, "content_type": {"const": "image/svg+xml"}, "body": {"type": "string"}, "summary": {"type": "object"}}
      },
      "EvaluationResponse": {
        "type": "object",
        "properties": {"status": {"const": "ok"}, "contract_version": {"type": "string"}, "model": {"type": "string"}, "operation": {"const": "evaluate"}, "metric": {"type": "string"}, "target": {}, "value": {"description": "A Value object, or an array of them for several targets."}, "summary": {"type": "object", "properties": {"nobs": {"type": "integer"}, "elapsed_ms": {"type": "integer"}}}}
      },
      "CalibrationResponse": {
        "type": "object",
        "properties": {"status": {"const": "ok"}, "contract_version": {"type": "string"}, "model": {"type": "string"}, "operation": {"const": "calibrate"}, "metric": {"type": "string"}, "target": {}, "config": {"type": "object", "description": "Nested `{System: {name: Value}}` objects (keyed by metric tuple when `pareto` is set)."}, "summary": {"type": "object", "properties": {"nobs": {"type": "integer"}, "nparameters": {"type": "integer"}, "elapsed_ms": {"type": "integer"}}}}
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {"const": "error"}, "contract_version": {"type": "string"},
          "error": {"type": "object", "properties": {
            "code": {"type": "string", "enum": ["invalid_request", "not_found", "method_not_allowed", "execution_failed"]},
            "category": {"type": "string", "enum": ["syntax", "validation", "routing", "method", "execution"]},
            "message": {"type": "string"}, "path": {"type": "string"}, "retryable": {"type": "boolean"}
          }}
        }
      },
      "ModelDescription": {
        "type": "object",
        "properties": {
          "contract": {"type": "object", "properties": {"version": {"type": "string"}}},
          "model": {"type": "object", "properties": {"name": {"type": "string"}, "module": {"type": "string"}}},
          "systems": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "module": {"type": "string"}, "root": {"type": "boolean"}, "path": {"type": "string"}}}},
          "parameters": {"type": "array", "items": {"$ref": "#/components/schemas/Variable"}},
          "variables": {"type": "array", "items": {"$ref": "#/components/schemas/Variable"}},
          "tables": {"type": "array", "items": {"$ref": "#/components/schemas/Variable"}}
        }
      },
      "Variable": {
        "type": "object",
        "properties": {
          "system": {"type": "string"}, "name": {"type": "string"}, "alias": {"type": ["string", "null"]},
          "path": {"type": "string", "description": "Configuration path `System.name`."},
          "declared": {"type": "string", "description": "Configuration path through the declaring system (differs from `path` for mixins)."},
          "target": {"type": "string", "description": "Access path usable in `target`, `index`, `stop`, `x`, `y`."},
          "description": {"type": "string"}, "state": {"type": ["string", "null"]}, "type": {"type": ["string", "null"]}, "unit": {"type": ["string", "null"]},
          "role": {"type": "string", "enum": ["parameter", "table", "output", "internal"]},
          "default": {"description": "Value object with the default under the server configuration (parameters only)."},
          "tags": {"type": "object"}, "dependencies": {"type": "array", "items": {"type": "string"}},
          "index": {"description": "Index column of a provided table (tables only)."},
          "columns": {"type": "array", "description": "Columns read by `drive` variables (tables only).", "items": {"type": "object", "properties": {"variable": {"type": "string"}, "name": {"type": "string"}, "column": {"type": "string"}, "unit": {"type": ["string", "null"]}}}}
        }
      },
      "WidgetPayload": {
        "type": "object",
        "properties": {
          "title": {"type": "string"}, "contract": {"type": "object"}, "model": {"type": "object"}, "systems": {"type": "array"},
          "controls": {"type": "array", "items": {"$ref": "#/components/schemas/Control"}},
          "outputs": {"type": "array", "items": {"$ref": "#/components/schemas/Variable"}},
          "tables": {"type": "array"},
          "simulation": {"type": "object", "properties": {"stop": {}, "snap": {}}},
          "visualize": {"type": "object"},
          "panels": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "x": {"type": "string"}, "y": {"type": "array", "items": {"type": "string"}}, "kind": {"type": "string"}, "xstep": {}}}},
          "sweeps": {"type": "array"}
        }
      },
      "Control": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["number", "checkbox", "text", "file"]},
          "role": {"type": "string", "enum": ["parameter", "table"]},
          "system": {"type": "string"}, "name": {"type": "string"}, "path": {"type": "string"}, "declared": {"type": "string"},
          "alias": {"type": ["string", "null"]}, "label": {"type": "string"}, "description": {"type": "string"},
          "unit": {"type": ["string", "null"]}, "default": {}, "value_type": {"type": "string"}, "state": {"type": ["string", "null"]},
          "min": {}, "max": {}, "step": {"type": ["number", "null"]},
          "accept": {"type": ["string", "null"]}, "columns": {"type": "array"}, "source": {"type": "string", "enum": ["dsl", "runtime"]}
        }
      }
    }
  }
}
